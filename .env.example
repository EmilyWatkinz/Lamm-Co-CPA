# Vercel / production environment variables for secure document upload
# Copy these values into Vercel -> Project -> Settings -> Environment Variables

SERVER_PORT=5001
UPLOAD_RECIPIENT_EMAIL=ar@lammcocpa.com
EMAIL_FROM=ar@lammcocpa.com
REACT_APP_UPLOAD_API_URL=/api/secure-upload
CORS_ORIGIN=*

# Preferred email method: Microsoft 365 SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your-sending-email@yourdomain.com
SMTP_PASS=your-smtp-password-or-app-password

# Alternative email method: Microsoft Graph (use if SMTP auth is disabled)
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_SENDER_USER=your-sending-email@yourdomain.com

# Upload limits
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_FILES=10
GRAPH_SIMPLE_SEND_MAX_BYTES=3500000
