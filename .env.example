# Outlook / Microsoft 365 SMTP settings
SERVER_PORT=5001
REACT_APP_UPLOAD_API_URL=http://localhost:5001/api/secure-upload
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_FUNCTIONS_REGION=us-central1
# The frontend now writes to Firestore collection `mail` and the Cloud Function watches it.
UPLOAD_RECIPIENT_EMAIL=ar@lammcocpa.com
EMAIL_FROM=ar@lammcocpa.com

# Preferred: Microsoft Graph (works when SMTP AUTH is disabled)
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_USER=ar@lammcocpa.com
GRAPH_SIMPLE_SEND_MAX_BYTES=3500000

# Fallback SMTP settings
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=ar@lammcocpa.com
SMTP_PASS=your-outlook-password-or-app-password
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_FILES=10
