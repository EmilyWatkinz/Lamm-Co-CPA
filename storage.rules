rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /secure-uploads/{allPaths=**} {
      // Allow signed-in users (including anonymous auth) to upload and fetch file URLs.
      allow read, write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
