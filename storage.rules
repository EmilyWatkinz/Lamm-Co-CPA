rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /secure-uploads/{allPaths=**} {
      // Allow direct uploads without requiring auth; files remain non-public.
      allow read: if false;
      allow write: if request.resource.size < 25 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
